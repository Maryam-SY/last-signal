{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc",
    "jsx-a11y",
    "unicorn"
  ],
  "ignorePatterns": [
    "dist/**",
    "public/draco/**"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "react/no-danger": "error",
    "react/jsx-no-script-url": "error",
    "no-eval": "error",
    "no-new-func": "error"
  }
}
