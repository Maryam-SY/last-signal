{
  "name": "last-signal",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p .claude/hooks",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "secrets": "node scripts/scan-secrets.mts",
    "audit": "pnpm audit --audit-level high",
    "verify": "node scripts/verify.mts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm secrets && pnpm build",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "pnpm@12.16.1"
}
